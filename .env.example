# MenuGuard AI Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Optional: Server automatically falls back to In-Memory Demo Storage if unconfigured/offline)
MONGODB_URI=mongodb://localhost:27017/menuguard

# Backboard AI Credentials (Optional: Server automatically falls back to labeled Mock Analysis Mode if unconfigured)
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_MODEL_NAME=meta-llama/llama-3.1-70b-instruct
BACKBOARD_LLM_PROVIDER=featherless

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5000/api
